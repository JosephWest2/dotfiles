{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git push *": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "git branch -D *": "ask",
      "git stash drop *": "ask",
      "git stash clear *": "ask",
      "git rebase *": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "npx *": "ask",
      "pnpm dlx *": "ask",
      "yarn dlx *": "ask",
      "bunx *": "ask",
      "npm install *": "ask",
      "pnpm install *": "ask",
      "yarn install *": "ask",
      "pip install *": "ask",
      "cargo install *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "gh pr merge *": "ask",
      "gh release *": "ask",
      "npm publish *": "ask",
      "cargo publish *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "systemctl *": "ask",
      "launchctl *": "ask",
      "dd *": "ask",
      "mkfs *": "ask",
      "shred *": "ask",
      "truncate *": "ask",
      "docker rm *": "ask",
      "docker system prune *": "ask",
      "docker compose down *": "ask",
      "kubectl apply *": "ask",
      "kubectl delete *": "ask",
      "helm upgrade *": "ask",
      "helm uninstall *": "ask",
      "terraform apply *": "ask",
      "terraform destroy *": "ask",
      "aws *": "ask",
      "gcloud *": "ask",
      "az *": "ask",
      "rm -rf *": {
        "action": "deny",
        "reason": "Recursive forced deletion is blocked by global policy"
      }
    },
    "external_directory": "ask"
  }
}
